##################################################
# .gitignore — MAUI VIP PRO (Android / iOS / Mac / Windows)
# Drop vào bất kỳ project MAUI nào.
##################################################

##################################################
# BẢO MẬT & KÝ SỐ — KHÔNG BAO GIỜ COMMIT
##################################################
# Android
*.keystore
*.jks
signing.properties        
keystore.properties       

# Apple
*.p12
*.mobileprovision         
*.provisionprofile        
ExportOptions.plist       

# Windows
*.pfx
*.cer                     

# SSH / CLI tools đặt cạnh script
ssh_id
ssh_id.pub
gh.exe

# Biến môi trường cục bộ
.env
.env.*
!.env.example
!.env.template
!.env.sample

# Config chỉ dùng trên máy dev
**/appsettings.*.local.json
local.properties
**/Platforms/Android/local.properties

##################################################
# BUILD .NET / MAUI
##################################################
[Dd]ebug/
[Rr]elease/
bin/
obj/
**/bin/
**/obj/
_ReSharper*/
BenchmarkDotNet.Artifacts/

# Local SDK (portable, auto-download by gbuild.ps1)
.sdk/
dotnet-sdk*.zip

##################################################
# ANDROID BUILD ARTIFACTS
##################################################
**/[Bb]in/**/*.apk
**/[Bb]in/**/*.aab
**/[Oo]bj/**/*.apk
**/[Oo]bj/**/*.aab
**/*.class
**/*.dex
**/android/bin/
**/android/obj/

##################################################
# IOS / MACCATALYST BUILD ARTIFACTS
##################################################
**/iOS/bin/
**/iOS/obj/
**/MacCatalyst/bin/
**/MacCatalyst/obj/

##################################################
# WINDOWS BUILD ARTIFACTS
##################################################
**/Windows/bin/
**/Windows/obj/
**/[Bb]in/**/*.appx
**/[Bb]in/**/*.msix
**/[Bb]in/**/*.msixbundle   
**/[Bb]in/**/*.appxbundle   
AppPackages/                

##################################################
# PUBLISH / ARTIFACT OUTPUT (script-managed)
##################################################
local-publish/
apk-output/
publish-output/              (dùng bởi build.yml)
artifacts/
publish/

##################################################
# NUGET
##################################################
*.nuget.props
*.nuget.targets
packages/
.librarymanager/

##################################################
# EDITOR — Visual Studio / VS Code / Rider
##################################################
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.DotSettings.user
*.user
*.suo
*.userosscache
*.sln.docstates

##################################################
# HỆ ĐIỀU HÀNH
##################################################
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*                         
.Spotlight-V100             
.Trashes                    
Icon?                       

##################################################
# LOG / TEMP / CACHE
##################################################
*.log
*.tmp
*.temp
*.cache
*.bak                       
*.orig                      

##################################################
# TEST / COVERAGE
##################################################
TestResults/
coverage/
*.coverage
*.coveragexml

# .devcontainer/
