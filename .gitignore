##################################################
# NUGET PACKAGES (BẮT BUỘC)
##################################################
*.nuget.props
*.nuget.targets
packages/
# Chặn cache của các công cụ phân tích code
.librarymanager/
# Chặn cấu hình môi trường máy ảo
.devcontainer/

##################################################
# BẢO MẬT & KEYSTORE (QUAN TRỌNG)
##################################################
# Chặn file ký app cục bộ để tránh lộ mật khẩu
*.keystore
*.jks
*.p12
*.pfx

# Chặn file cấu hình bí mật của .NET
usersecretsid
appsettings.Development.json

##################################################
# MAUI SPECIFIC FIXES
##################################################
# Chặn các file rác phát sinh khi build trên Mac/Windows
[Dd]ebug/
[Rr]elease/
_ReSharper*/

# .NET build output
bin/
obj/

# Rider / VS build artifacts
**/bin/
**/obj/

##################################################
# MAUI ANDROID (CỰC QUAN TRỌNG – TRÁNH PATH QUÁ DÀI)
##################################################

**/android/bin/
**/android/obj/

# Generated Java / class files
**/*.class
**/*.dex
**/*.apk
**/*.aab

##################################################
# MAUI iOS / MacCatalyst
##################################################

**/iOS/bin/
**/iOS/obj/
**/MacCatalyst/bin/
**/MacCatalyst/obj/

##################################################
# MAUI Windows
##################################################

**/Windows/bin/
**/Windows/obj/

##################################################
# Visual Studio / VS Code
##################################################

.vs/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.user
*.suo
*.userosscache
*.sln.docstates

##################################################
# OS / SYSTEM FILES
##################################################

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store

##################################################
# LOGS / CACHE / TEMP
##################################################

*.log
*.tmp
*.temp
*.cache

##################################################
# TEST / COVERAGE
##################################################

TestResults/
coverage/
*.coverage
*.coveragexml

##################################################
