##################################################
# NUGET / CÔNG CỤ
##################################################
*.nuget.props
*.nuget.targets
packages/
.librarymanager/

# Dev Container: nhiều team *commit* .devcontainer để đồng bộ môi trường.
# Bỏ dòng dưới nếu bạn không bao giờ commit Dev Container.
# .devcontainer/

##################################################
# BẢO MẬT & KÝ SỐ
##################################################
*.keystore
*.jks
*.p12
*.pfx

# Khóa SSH / gh.exe đặt cạnh script (git-sync / build) — không đưa lên remote
ssh_id
ssh_id.pub
gh.exe

# Biến môi trường cục bộ (giữ template có thể commit)
.env
.env.*
!.env.example
!.env.template
!.env.sample

# File cấu hình chỉ dùng trên máy dev (không ignore appsettings.Development.json mặc định)
**/appsettings.*.local.json

##################################################
# BUILD .NET / MAUI
##################################################
[Dd]ebug/
[Rr]elease/
_ReSharper*/
bin/
obj/
**/bin/
**/obj/

# Rider / JetBrains
.idea/
*.DotSettings.user

# Visual Studio
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.user
*.suo
*.userosscache
*.sln.docstates

##################################################
# MAUI ANDROID (tránh path quá dài; SDK path cục bộ)
##################################################
**/android/bin/
**/android/obj/
**/Platforms/Android/local.properties
local.properties

# Các file build Android trong thư mục build (không ignore *.apk/*.aab ở mọi nơi — có thể cần commit bản phát hành)
**/[Bb]in/**/*.apk
**/[Bb]in/**/*.aab
**/[Oo]bj/**/*.apk
**/[Oo]bj/**/*.aab
**/*.class
**/*.dex

##################################################
# MAUI iOS / MacCatalyst
##################################################
**/iOS/bin/
**/iOS/obj/
**/MacCatalyst/bin/
**/MacCatalyst/obj/

##################################################
# MAUI WINDOWS
##################################################
**/Windows/bin/
**/Windows/obj/
**/[Bb]in/**/*.appx
**/[Bb]in/**/*.msix

##################################################
# HỆ ĐIỀU HÀNH
##################################################
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

##################################################
# LOG / TEMP
##################################################
*.log
*.tmp
*.temp
*.cache

##################################################
# TEST / COVERAGE
##################################################
TestResults/
coverage/
*.coverage
*.coveragexml

##################################################
# PUBLISH / ARTIFACT
##################################################
publish/
artifacts/
BenchmarkDotNet.Artifacts/

# Xuất bản cục bộ (git-sync) — không đưa lên GitHub
local-publish/
apk-output/
