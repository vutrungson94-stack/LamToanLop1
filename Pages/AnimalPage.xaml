<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
    x:Class="LamToanLop1.Pages.AnimalPage"
    Title="Khám phá động vật"
    BackgroundColor="#E0F7FA"
    Shell.NavBarIsVisible="False">

    <!-- Sử dụng Grid chia 4 hàng: Nút Home - Ảnh - Tên - Nút bấm -->
    <Grid RowDefinitions="Auto, *, Auto, Auto" 
          RowSpacing="15" 
          Padding="15, 15, 15, 15">

        <!-- 1. Nút Home: Đưa vào giữa hàng trên cùng -->
        <Button 
            Grid.Row="0"
            Text="🏠 Home"
            FontSize="14"
            FontAttributes="Bold"
            HeightRequest="44" 
            WidthRequest="110"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Margin="0, 30, 0, 0"
            Clicked="OnHomeClicked"
            BackgroundColor="White"
            CornerRadius="22"
            Padding="10, 5"
            TextColor="#2E7D32"
            BorderColor="#4CAF50"
            BorderWidth="1">
            <Button.Shadow>
                <Shadow Brush="Black" Offset="1,1" Opacity="0.3"/>
            </Button.Shadow>
        </Button>

        <!-- 2. Khung ảnh con vật (Chiếm phần giữa màn hình) -->
        <Border 
            Grid.Row="1"
            StrokeShape="RoundRectangle 20" 
            Padding="15" 
            Stroke="#4CAF50" 
            StrokeThickness="3"
            BackgroundColor="#FFFFFF" 
            HorizontalOptions="Fill"
            VerticalOptions="Center" 
            Margin="10, 0"
            HeightRequest="300">
            
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAnimalImageTapped" />
            </Border.GestureRecognizers>
            
            <Image 
                x:Name="AnimalImage" 
                Aspect="AspectFit"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
        </Border>

        <!-- 3. Tên con vật + Loa -->
        <HorizontalStackLayout 
            Grid.Row="2"
            HorizontalOptions="Center" 
            Spacing="15" 
            VerticalOptions="Center"
            Margin="0, 0, 0, 10">
            
            <ImageButton
                Source="bieutuong_loa.png"
                BackgroundColor="#FFE0B2"
                CornerRadius="22"
                HeightRequest="48"
                WidthRequest="48"
                Aspect="AspectFit"
                BorderColor="#FF9800"
                BorderWidth="2"
                Clicked="OnReplaySound"
                VerticalOptions="Center">
                <ImageButton.Shadow>
                    <Shadow Brush="Gray" Offset="1,1" Opacity="0.5"/>
                </ImageButton.Shadow>
            </ImageButton>
            
            <Label 
                x:Name="AnimalName" 
                FontFamily="BalooTammudu2ExtraBold"
                FontSize="32" 
                FontAttributes="Bold" 
                TextColor="#2E7D32" 
                HorizontalOptions="Center" 
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                MaxLines="2">
                <Label.Shadow>
                    <Shadow Brush="Black" Offset="2,2" Opacity="0.3"/>
                </Label.Shadow>
            </Label>
        </HorizontalStackLayout>

        <!-- 4. Nút điều hướng (Xem lại / Tiếp theo) -->
        <Grid 
            Grid.Row="3"
            ColumnDefinitions="*,*" 
            ColumnSpacing="15" 
            Margin="0, 0, 0, 5">
            
            <Button 
                x:Name="BtnBack" 
                FontFamily="NunitoExtraBold"
                Text="⬅️ Xem lại" 
                Clicked="OnBack"
                BackgroundColor="#90A4AE" 
                CornerRadius="25" 
                HeightRequest="55"
                FontAttributes="Bold" 
                TextColor="White"/>

            <Button 
                Grid.Column="1" 
                Text="Tiếp theo ➡️" 
                FontFamily="NunitoExtraBold"
                Clicked="OnNext"
                BackgroundColor="#FF9800" 
                CornerRadius="25" 
                HeightRequest="55"
                FontAttributes="Bold" 
                TextColor="White"/>
        </Grid>
    </Grid>
</ContentPage>