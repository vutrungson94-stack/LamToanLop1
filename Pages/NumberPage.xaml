<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LamToanLop1.Pages.NumberPage"
             Title="KHÁM PHÁ CON SỐ"
             BackgroundColor="#E3F2FD"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Hình nền đồng nhất -->
        <Image Source="hinhnen_lam_toan_lop_1.webp" 
               Aspect="AspectFill" 
               Opacity="0.3"/>

        <!-- ===== STATE 1: Chọn phạm vi số ===== -->
        <VerticalStackLayout x:Name="RangeSelectionLayout"
                             Spacing="25" 
                             VerticalOptions="Center" 
                             HorizontalOptions="Center" 
                             Padding="20">
            
            <Label Text="CHỌN PHẠM VI SỐ" 
                   FontFamily="BalooTammudu2ExtraBold"
                   FontSize="36" 
                   FontAttributes="Bold" 
                   TextColor="#333" 
                   HorizontalOptions="Center" />

            <Button Text="🎯 SỐ TỪ 0 ĐẾN 9" 
                    Clicked="OnRange0to9Clicked"
                    BackgroundColor="#4CAF50"
                    FontFamily="NunitoExtraBold"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"
                    CornerRadius="25"
                    HeightRequest="70"
                    WidthRequest="300"
                    Margin="0,20">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="2,4" Opacity="0.3" Radius="5"/>
                </Button.Shadow>
            </Button>

            <Button Text="🎯 SỐ TỪ 10 ĐẾN 20" 
                    Clicked="OnRange10to20Clicked"
                    BackgroundColor="#2196F3"
                    FontFamily="NunitoExtraBold"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"
                    CornerRadius="25"
                    HeightRequest="70"
                    WidthRequest="300"
                    Margin="0,10">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="2,4" Opacity="0.3" Radius="5"/>
                </Button.Shadow>
            </Button>

            <Button Text="🎲 SỐ NGẪU NHIÊN (21-100)" 
                    Clicked="OnRange20PlusClicked"
                    BackgroundColor="#9C27B0"
                    FontFamily="NunitoExtraBold"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"
                    CornerRadius="25"
                    HeightRequest="70"
                    WidthRequest="300"
                    Margin="0,10">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="2,4" Opacity="0.3" Radius="5"/>
                </Button.Shadow>
            </Button>

            <Button Text="🔙 QUAY LẠI" 
                    Clicked="OnBackToMenuClicked"
                    BackgroundColor="#757575"
                    FontFamily="NunitoExtraBold"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="White"
                    CornerRadius="25"
                    HeightRequest="55"
                    WidthRequest="200"
                    Margin="0,30">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="2,4" Opacity="0.3" Radius="5"/>
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>

        <!-- ===== STATE 2: Hiển thị & đọc các con số ===== -->
        <Grid x:Name="NumbersDisplayLayout" 
              IsVisible="False"
              RowDefinitions="Auto,*,Auto" 
              Padding="20"
              VerticalOptions="Fill">

            <!-- Tiêu đề phạm vi đang học -->
            <Border Grid.Row="0" 
                    Stroke="#2196F3" 
                    StrokeThickness="3" 
                    BackgroundColor="#FFFFFF" 
                    Padding="15,10" 
                    Margin="0,10,0,15"
                    StrokeShape="RoundRectangle 25"
                    HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="2,2" Opacity="0.2" Radius="4"/>
                </Border.Shadow>
                <Label x:Name="RangeTitleLabel"
                       FontFamily="BalooTammudu2ExtraBold"
                       Text="SỐ TỪ 0 ĐẾN 9" 
                       FontSize="26" 
                       FontAttributes="Bold" 
                       TextColor="#1565C0" 
                       HorizontalTextAlignment="Center"/>
            </Border>

            <!-- Vùng chứa các con số (cuộn được) - xếp 3 cột -->
            <ScrollView Grid.Row="1">
                <Grid x:Name="NumbersGrid"
                      ColumnDefinitions="*,*,*"
                      ColumnSpacing="12"
                      RowSpacing="12"
                      Padding="4"/>
            </ScrollView>

            <!-- Nút chuyển phạm vi + dãy số ngẫu nhiên mới (nút sau chỉ hiện ở chế độ ngẫu nhiên) -->
            <VerticalStackLayout Grid.Row="2"
                                 Spacing="8"
                                 HorizontalOptions="Fill"
                                 Padding="0,10,0,0">
                <Button x:Name="GenerateRandomButton"
                        Text="🎲 TẠO DÃY SỐ MỚI"
                        Clicked="OnGenerateRandomClicked"
                        BackgroundColor="#8E24AA"
                        FontFamily="NunitoExtraBold"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="55"
                        HorizontalOptions="Fill"
                        Margin="0"
                        IsVisible="False">
                    <Button.Shadow>
                        <Shadow Brush="Black" Offset="2,4" Opacity="0.3" Radius="5"/>
                    </Button.Shadow>
                </Button>

                <Button x:Name="BackToRangesButton"
                        Text="🔁 CHỌN PHẠM VI"
                        Clicked="OnBackToRangesClicked"
                        BackgroundColor="#FF9800"
                        FontFamily="NunitoExtraBold"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="55"
                        HorizontalOptions="Fill"
                        Margin="0">
                    <Button.Shadow>
                        <Shadow Brush="Black" Offset="2,4" Opacity="0.3" Radius="5"/>
                    </Button.Shadow>
                </Button>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
