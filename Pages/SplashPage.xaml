<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LamToanLop1.Pages.SplashPage"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Lúc này AspectFill sẽ thực sự tràn viền 100% màn hình -->
        <Image Source="Resources/Images/hinhnen_lam_toan_lop_1.webp" 
               Aspect="AspectFill" 
               HorizontalOptions="Fill" 
               VerticalOptions="Fill" />

        <!-- Bạn có thể thêm Label "Đang tải game..." hoặc ProgressBar ở đây -->
        <!-- Overlay nội dung loading -->
        <VerticalStackLayout Padding="24"
                             Spacing="12"
                             VerticalOptions="End"
                             HorizontalOptions="Fill">

            <Label x:Name="ProgressLabel"
                   Text="0%"
                   TextColor="White"
                   HorizontalTextAlignment="Center"/>

            <ProgressBar x:Name="PreloadProgressBar"
                         Progress="0"
                         IsVisible="True"
                         HeightRequest="8"
                         ProgressColor="#FF9800"/>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
