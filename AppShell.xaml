<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:LamToanLop1.Pages"
    x:Class="LamToanLop1.AppShell">

    <ShellContent
        Title="Loading..."
        ContentTemplate="{DataTemplate pages:SplashPage}"
        Route="SplashPage"
        Shell.FlyoutBehavior="Disabled" />

    <ShellContent
        Title="Bé làm toán lớp 1"
        ContentTemplate="{DataTemplate pages:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Bé Khám Phá Thế Giới Động Vật"
        ContentTemplate="{DataTemplate pages:AnimalPage}"
        Route="AnimalPage" />

    <ShellContent
        Title="Bé Thử Tài Toán Học"
        ContentTemplate="{DataTemplate pages:GamePage}"
        Route="GamePage" />

</Shell>